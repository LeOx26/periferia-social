{
  "title": "Periferia Social",
  "uid": "periferia-social",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Publicaciones creadas",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(periferia_posts_published_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Likes registrados",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(periferia_likes_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Sesiones WebSocket activas",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "periferia_websocket_sessions_active", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Servicios arriba",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "count(up == 1)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Peticiones por segundo por servicio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Likes por minuto",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [{ "expr": "rate(periferia_likes_total[1m]) * 60", "refId": "A" }]
    }
  ]
}
