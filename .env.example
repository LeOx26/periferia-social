# Copiar a .env para sobrescribir los valores de desarrollo del docker-compose.
#
# JWT_SECRET debe ser IDÉNTICO en auth-service y social-service: auth firma con él
# y social verifica la firma en local, sin llamar nunca a auth. HS256 exige al
# menos 32 bytes.
JWT_SECRET=cambia-esto-en-produccion-minimo-32-bytes-para-hs256

POSTGRES_USER=periferia
POSTGRES_PASSWORD=periferia
